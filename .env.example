# Copy to .env.local and fill in local secret values.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_LEGAL_MODEL="gemini-2.5-flash"
GEMINI_LEGAL_FALLBACK_MODEL="gemini-3.8-flash"
AI_SERVICE_URL="http://127.0.0.1:8000"
ALLOW_SIMULATION="false"
ROBOFLOW_MODEL_ID="your-workspace/your-project/version"
